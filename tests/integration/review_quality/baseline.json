      "unlabeled": [
        {
          "case": "unset-proto-field-treated-as-zero",
          "run": "1",
          "file": "mlflow/store/tracking/sqlalchemy_store.py",
          "line": 1050,
          "severity": "medium",
          "message": "When `max_results=0`, the query uses `limit(1)`. If at least one row exists, `len(metrics) == max_results + 1` is true and the store returns an empty page with a next token whose offset equals the current offset. A client that follows tokens until none is left loops forever. Together with the handler defaulting `max_results` to 0, ordinary paging clients could hang."
        },
        {
          "case": "fish-completion-splits-on-unquoted-newline",
          "run": "1",
          "file": "src/click/shell_completion.py",
          "line": 182,
          "severity": "high",
          "message": "Fish command substitution splits the output on newlines, so `$response` now holds one line per element instead of one whole completion. The loop handles each line as its own completion, which means `string split \\n` always returns a single element and `$metadata[2]`/`$metadata[3]` are empty. As a result, Fish completion stops working entirely. The loop has to step through `$response` three elements at a time, the way the zsh script does."
        },
        {
          "case": "fish-completion-splits-on-unquoted-newline",
          "run": "1",
          "file": "src/click/shell_completion.py",
          "line": 189,
          "severity": "medium",
          "message": "Because the loop sees one line at a time, `$metadata[3]` is always empty here. An unquoted empty list expansion makes `test` receive `!= _` with no left operand, so it fails or prints errors. Even after the loop is fixed, the variables should be quoted."
        },
        {
          "case": "fish-completion-splits-on-unquoted-newline",
          "run": "1",
          "file": "tests/test_shell_completion.py",
          "line": 594,
          "severity": "low",
          "message": "The new test only checks the Python output format, so it can't catch the broken Fish script. That is how the per-line split bug got through. A test against the real Fish script, or at least one that checks the script's parsing logic, is needed."
        },
        {
          "case": "indexable-hands-wrapped-frames-to-estimators",
          "run": "1",
          "file": "sklearn/utils/validation.py",
          "line": 2335,
          "severity": "medium",
          "message": "Fit params such as a pandas `sample_weight` Series now become narwhals Series before they reach `fit`. Downstream code such as `check_array` only recognises native dataframes through `_nw_is_into_df_or_series`, so a narwhals wrapper may skip the dataframe path. This could cause wrong conversion or dropped feature names."
        },
        {
          "case": "indexable-hands-wrapped-frames-to-estimators",
          "run": "1",
          "file": "sklearn/utils/validation.py",
          "line": 482,
          "severity": "low",
          "message": "The `hasattr(iterable, 'iloc')` check was removed. Objects that expose `iloc` but not `__getitem__`, and that narwhals doesn't recognise, are now converted with `np.array`, which loses their type. The MockDataFrame tests that covered this case were deleted rather than adapted."
        },
        {
          "case": "db-pool-closed-after-each-task-in-thread-pools",
          "run": "1",
          "file": "celery/fixups/django.py",
          "line": 204,
          "severity": "low",
          "message": "`close_pool()` is in the same `try` block as `conn.close()`. If `close()` raises an interface or DatabaseError that gets swallowed, the pool is never closed, so pooled connections can still be shared with the forked process."
        },
        {
          "case": "parser-cancellation-leaves-connection-open",
          "run": "1",
          "file": "aiohttp/worker.py",
          "line": 125,
          "severity": "medium",
          "message": "`_run` used to catch `BaseException`, which included `asyncio.CancelledError`. Now that it only catches `Exception`, cancelling the `_run` task (or a `KeyboardInterrupt`/`SystemExit` raised inside it) skips `await runner.cleanup()`. Sites stay unclosed, connections aren't drained and on_shutdown/on_cleanup hooks don't run during graceful shutdown."
        },
        {
          "case": "new-required-kwarg-breaks-direct-responder-use",
          "run": "1",
          "file": "starlette/middleware/gzip.py",
          "line": 138,
          "severity": "medium",
          "message": "`IdentityResponder.apply_compression` changed from a sync method to a coroutine, and `send_with_compression` now awaits it. Existing subclasses that override `apply_compression` with a plain method returning bytes (e.g. Brotli or zstd responders built on `IdentityResponder`) will raise `TypeError: object bytes can't be used in 'await' expression` on every response."
        },
        {
          "case": "password-hasher-decodes-bytes-as-utf8",
          "run": "1",
          "file": "django/contrib/auth/hashers.py",
          "line": 256,
          "severity": "low",
          "message": "`_check_encode_args` now runs `force_str` on bytes salts. If a bytes salt isn't valid UTF-8, it raises a decode error instead of the documented `ValueError` about salt validity. The same check runs for MD5, PBKDF2 and scrypt."
        },
        {
          "case": "async-login-leaves-stale-request-user",
          "run": "1",
          "file": "django/contrib/auth/__init__.py",
          "line": 276,
          "severity": "medium",
          "message": "`alogout` no longer resets `request.user` to `AnonymousUser`. After logout, `request.user` can still return the logged-out user, so the rest of that request may treat them as authenticated, for example when rendering templates or running permission checks."
        }
      ]
